# Copy to server/.env for local work. On Render these are set in the dashboard / render.yaml.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/rto
# true when the database requires SSL (Supabase, Neon, external Render URL)
PGSSL=false
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
NODE_ENV=development
# first start only: creates this admin when the users table is empty
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
# https://aistudio.google.com -> Get API key (only for photographed PODs)
GEMINI_API_KEY=
# the Netlify address allowed to call this API (comma separated for several)
CORS_ORIGIN=https://pokonutrto.netlify.app
